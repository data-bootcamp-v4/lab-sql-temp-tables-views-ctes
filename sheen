USE sakila;

-- Step 1: Create a View (rental summary per customer)
CREATE OR REPLACE VIEW v_customer_rental_summary AS
SELECT
  c.customer_id,
  CONCAT(c.first_name, ' ', c.last_name) AS customer_name,
  c.email,
  COUNT(r.rental_id) AS rental_count
FROM customer c
LEFT JOIN rental r
  ON r.customer_id = c.customer_id
GROUP BY
  c.customer_id, c.first_name, c.last_name, c.email;

-- Step 2: Create a Temporary Table (total paid per customer)
DROP TEMPORARY TABLE IF EXISTS tmp_customer_payment_summary;

CREATE TEMPORARY TABLE tmp_customer_payment_summary AS
SELECT
  v.customer_id,
  COALESCE(SUM(p.amount), 0) AS total_paid
FROM v_customer_rental_summary v
LEFT JOIN payment p
  ON p.customer_id = v.customer_id
GROUP BY v.customer_id;

-- Step 3: Create a CTE + Final Customer Summary Report
WITH customer_summary AS (
  SELECT
    v.customer_name,
    v.email,
    v.rental_count,
    t.total_paid
  FROM v_customer_rental_summary v
  JOIN tmp_customer_payment_summary t
    ON t.customer_id = v.customer_id
)
SELECT
  customer_name,
  email,
  rental_count,
  total_paid,
  CASE
    WHEN rental_count = 0 THEN 0
    ELSE ROUND(total_paid / rental_count, 2)
  END AS average_payment_per_rental
FROM customer_summary
ORDER BY total_paid DESC, rental_count DESC, customer_name;
